# Copy this file to .env.local (or .env) to override these locally.
# Both variables below are PUBLIC frontend configuration — Vite inlines
# them into the built JS bundle, so never put a secret in a VITE_*
# variable. Backend secrets (OAuth client secrets, Stripe keys, the
# session secret, etc.) live only in server/.env, which is never bundled
# or shipped to the browser — see server/.env.example.

# The PUBLIC URL of the backend/API (no trailing slash), e.g.
# http://localhost:8787 for local development. For GitHub Pages set it as
# the repository VARIABLE `VITE_API_BASE` (Settings -> Secrets and variables
# -> Actions -> Variables) once the backend is deployed; do not guess it.
# Google/Discord sign-in, saved statistics and paid categories need it.
# Leave unset (or empty) for guest-only mode, or when the backend serves
# these built files itself. See docs/BACKEND.md.
VITE_API_BASE=

# Only needed to preview a GitHub Pages-style subpath deployment locally
# (e.g. `VITE_BASE_PATH=/flag-game-meridian/ npm run build && npm run preview`).
# The GitHub Actions workflow (.github/workflows/deploy-pages.yml) sets
# this automatically at deploy time from the repository name, so you do
# not need to set it for a normal deploy. Leave unset for local dev, for
# a custom domain, or for a "<user>.github.io" root repo — all of those
# are served at "/".
VITE_BASE_PATH=
