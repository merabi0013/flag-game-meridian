# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Core -----------------------------------------------------------------
PORT=8787
NODE_ENV=development
# Where the frontend is served from (used for CORS + post-login redirects).
# If the backend is also serving the static frontend (see README), this can
# just be http://localhost:8787. If the frontend is deployed separately —
# e.g. to GitHub Pages (see root README "Deploying to GitHub Pages") — set
# this to that deployment's exact origin, no trailing slash, including the
# GitHub Pages subpath if it's a project site:
#   CLIENT_URL=https://<user>.github.io/<repo>
# or, with a custom domain:
#   CLIENT_URL=https://your-domain.example
# This value is used both for CORS (only this origin may call the API with
# credentials) and to build absolute post-login redirect URLs, so it must
# match the frontend's real deployed origin exactly or sign-in will
# redirect back to the wrong place.
CLIENT_URL=http://localhost:8787
# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-value

# --- SQLite -----------------------------------------------------------------
# Path to the SQLite database file. Created automatically on first run.
DB_PATH=./data/meridian.sqlite3

# --- Admin bootstrap --------------------------------------------------------
# Comma-separated emails that get administrator access granted automatically
# the first time they log in via Google/Discord. This only GRANTS — removing
# an email here later does not revoke access already granted (see
# server/lib/adminEmails.js for why). Leave empty and grant the first admin
# directly in the database instead if you'd rather not use this at all — see
# README "How to create the first administrator".
ADMIN_EMAILS=

# --- Google OAuth -----------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8787/auth/google/callback

# --- Discord OAuth ------------------------------------------------------------
# Create an application at https://discord.com/developers/applications
# Add GOOGLE-style redirect under OAuth2 > Redirects, matching the URL below.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:8787/auth/discord/callback

# --- Payments (Stripe) -------------------------------------------------------
# Get test-mode keys at https://dashboard.stripe.com/test/apikeys — these
# are separate from your live keys and never move real money. Leave both
# blank to keep paid categories disabled (the free game is unaffected).
STRIPE_SECRET_KEY=
# Optional but recommended for production: create a webhook endpoint at
# https://dashboard.stripe.com/test/webhooks pointing to
# <your-domain>/api/webhooks/stripe, subscribed to checkout.session.completed,
# then paste its signing secret here. Not required for local/sandbox
# testing — GET /api/purchase/confirm covers that path on its own.
STRIPE_WEBHOOK_SECRET=
