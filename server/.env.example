# Copy this file to server/.env for local development and fill in real
# values. NEVER commit the real .env (it is git-ignored). In production set
# these as environment variables in your hosting provider's dashboard
# instead — see docs/BACKEND.md.
#
# Nothing in this file is ever sent to the browser. The React app has no
# access to any of it.

# --- Core ---------------------------------------------------------------
PORT=8787
NODE_ENV=development

# Where the React app is served from: the exact URL people open, INCLUDING
# the GitHub Pages sub-path, no trailing slash. Used for post-login
# redirects and (its origin) the CORS allow-list.
#   local dev (Vite):  http://localhost:5173
#   GitHub Pages:      https://<user>.github.io/<repo>
#   custom domain:     https://your-domain.example
CLIENT_URL=http://localhost:5173

# Where THIS server is reachable from a browser, no trailing slash. The
# OAuth callback URLs are derived from it: <API_PUBLIC_URL>/auth/<provider>/callback
#   local dev:   http://localhost:8787
#   production:  the real https URL your backend host gives you
#                (do NOT guess it — copy it from the host after deploying)
API_PUBLIC_URL=http://localhost:8787

# Extra browser origins allowed to call the API, comma-separated (rarely needed).
CORS_EXTRA_ORIGINS=

# --- Database (PostgreSQL) -------------------------------------------------
# A standard PostgreSQL connection string. With Neon, copy it from the
# project's "Connection details" panel (use the POOLED connection string
# for the running server). Keep "?sslmode=require".
#   postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=
# Max connections this server opens (Neon free tier: keep small).
DATABASE_POOL_MAX=5

# --- Sessions --------------------------------------------------------------
# Signs the short-lived (10 minute) sign-in handshake cookie. Required in
# production, at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# How long a signed-in session lasts without use, in days (slides forward while in use).
SESSION_TTL_DAYS=30
# Per-IP requests per minute allowed on the sign-in endpoints.
AUTH_RATE_LIMIT_PER_MINUTE=60

# --- Google sign-in --------------------------------------------------------
# https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web application)
# Authorised redirect URI must EXACTLY equal the callback URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to <API_PUBLIC_URL>/auth/google/callback
GOOGLE_CALLBACK_URL=

# --- Discord sign-in -------------------------------------------------------
# https://discord.com/developers/applications -> your app -> OAuth2
# Add the callback URL below under "Redirects".
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional. Defaults to <API_PUBLIC_URL>/auth/discord/callback
DISCORD_CALLBACK_URL=

# --- Admin bootstrap -------------------------------------------------------
# Comma-separated emails that are granted administrator access the first
# time they sign in with a provider-VERIFIED address. Grant-only: removing
# an email later does not revoke access already granted.
ADMIN_EMAILS=

# --- Payments (Stripe) — optional --------------------------------------------
# Leave blank to keep paid categories disabled (free play is unaffected).
# Test-mode keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Signing secret of a webhook endpoint pointing at <API_PUBLIC_URL>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
